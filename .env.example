# Google Gemini API Key (get a free key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# IMAP Email Monitoring (optional - leave unset to disable)
# Example for Gmail:
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_SECURE=true
# IMAP_USER=your_gmail_address@gmail.com
# IMAP_PASSWORD=your_gmail_app_password (generate in Google Account settings)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
